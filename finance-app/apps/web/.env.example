# PostgreSQL connection string (Supabase or Neon in production; local Docker Compose in dev)
DATABASE_URL=postgres://finance_app:finance_app@localhost:5432/finance_app

# The only email allowed to sign in to this app (normalized to lowercase, no surrounding spaces)
AUTHORIZED_EMAIL=you@example.com

# Auth.js / NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string
