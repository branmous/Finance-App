FROM node:20-slim

RUN corepack enable

WORKDIR /workspace

COPY . .

# The hoisted linker installs real directories instead of pnpm's symlinked
# virtual store, which avoids broken bin links such as node_modules/turbo/bin/turbo.
RUN pnpm install --frozen-lockfile --config.node-linker=hoisted \
  && pnpm exec turbo --version

CMD ["pnpm", "exec", "turbo", "run", "lint", "test"]
